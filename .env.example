# Copy to .env and fill in. .env is gitignored.

# --- LLM provider (set at least one) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Which provider/model the agent uses. Supported: claude-3-5-sonnet-latest,
# claude-3-7-sonnet-latest, claude-sonnet-4-6, gpt-4o, gpt-4.1
LLM_MODEL=claude-sonnet-4-6

# --- Deployment target ---
# local | cloud
DEPLOY_TARGET=local

# Cluster name (kind) or context (cloud). For cloud, point KUBECONFIG yourself.
CLUSTER_NAME=knative-o

# --- Versions (tracked in §6.1) ---
# KNATIVE_VERSION must match a knative/operator release tag (without the
# leading "v"); verified to exist.
KNATIVE_VERSION=1.19.0
# OpenTelemetry Astronomy Shop: we install the official Helm chart. The chart
# version pins the app; appVersion 2.2.0 ships the 2.2.0-* images.
OTEL_DEMO_CHART_VERSION=0.40.9
ASTRONOMY_SHOP_VERSION=2.2.0
# Helm chart pins for the platform. Leave EMPTY to let Helm resolve the latest
# version of each chart (recommended unless you need a reproducible pin).
KUBE_PROMETHEUS_STACK_VERSION=
OTEL_OPERATOR_VERSION=
CERT_MANAGER_VERSION=

# --- Agent runtime ---
# confirm | auto -- see §6.5
AGENT_MODE=confirm
# Shared secret Alertmanager must send in the X-Webhook-Token header
WEBHOOK_TOKEN=change-me-to-a-random-string

# --- Observability ---
GRAFANA_ADMIN_PASSWORD=
# Optional: LangSmith for tracing agent runs
LANGCHAIN_TRACING_V2=
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=knative-o
