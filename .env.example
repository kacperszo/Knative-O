# Copy to .env and fill in. .env is gitignored.

# --- LLM provider (set at least one) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Which provider/model the agent uses. Supported: claude-3-5-sonnet-latest,
# claude-3-7-sonnet-latest, claude-sonnet-4-6, gpt-4o, gpt-4.1
LLM_MODEL=claude-sonnet-4-6

# --- Deployment target ---
# local | cloud
DEPLOY_TARGET=local

# Cluster name (kind) or context (cloud). For cloud, point KUBECONFIG yourself.
CLUSTER_NAME=knative-o

# --- Versions (tracked in §6.1) ---
KNATIVE_VERSION=1.19.0
KUBE_PROMETHEUS_STACK_VERSION=66.3.1
OTEL_OPERATOR_VERSION=0.71.0
CERT_MANAGER_VERSION=1.16.1
ASTRONOMY_SHOP_VERSION=1.13.0

# --- Agent runtime ---
# confirm | auto -- see §6.5
AGENT_MODE=confirm
# Shared secret Alertmanager must send in the X-Webhook-Token header
WEBHOOK_TOKEN=change-me-to-a-random-string

# --- Observability ---
GRAFANA_ADMIN_PASSWORD=
# Optional: LangSmith for tracing agent runs
LANGCHAIN_TRACING_V2=
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=knative-o
